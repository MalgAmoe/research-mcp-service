FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" PLAYWRIGHT_BROWSERS_PATH=/opt/playwright \
    XDG_CACHE_HOME=/opt/cache HOME=/tmp/worker-home
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgtk-3-0 libx11-xcb1 libasound2 \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --no-cache \
    && playwright install --with-deps chromium \
    && python -m camoufox fetch \
    && mkdir -p /rpc && chown 10001:10001 /rpc && chmod 700 /rpc
COPY src ./src
COPY README.md LICENSE ./
RUN uv sync --locked --no-dev --no-cache
COPY scripts/browser_controller.py /app/scripts/browser_controller.py
USER 10001:10001
CMD ["python", "-m", "research_mcp_service.worker_server"]
